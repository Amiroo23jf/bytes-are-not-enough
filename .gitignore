# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Jupyter
.ipynb_checkpoints/

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# --- IDEs / editors --------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- SLURM -----------------------------------------------------------------
logs/
outputs/**/run-*.log
*.slurm.out
*.slurm.err

# --- Outputs ---------------------------------------------------------------
# Paper artifacts under outputs/ (figures, summaries, small result files) are
# tracked. Note that the `logs/` rule above also matches outputs/*/logs/, so
# per-seed training logs there are not tracked.

# --- Misc scratch ----------------------------------------------------------
outputs/scratch/
outputs/tmp/

# --- wikitext_span_transformer ---------------------------------------------
# Tokenized WikiText-103 (~3.4 GB), regenerated by the prepare stage.
outputs/wikitext_span_transformer/data/
# Per-job SLURM tee logs.
outputs/wikitext_span_transformer/*.log
